# ---- NEVER COMMIT THESE: personal secrets & data ----

# API keys and provider settings (created by the setup window)
engine/config.json

# The characters' diaries, beliefs, scenes — personal roleplay data
engine/memory.db
engine/memory.db-journal
engine/memory.db-wal
engine/memory.db-shm

# Per-character schedules
engine/biopsychosocial_state.json

# Runtime-generated prompts and traces may contain private conversations.
debug/

# User-managed Lorebook files and preset-specific assignments.
Lorebooks/books/*.json
Lorebooks/settings.json
!Lorebooks/books/.gitkeep

# Local Python environment
.venv/

# Local launcher
start_brainengine.bat

# SillyTavern itself is an external application.  Only the independent
# extension snapshot in SillyTavern-extention/extensions is versioned here.
SillyTavern-extention/SillyTavern/

# ---- Python noise ----
__pycache__/
*.pyc
*.pyo
